{
  "data": {
    "uci_ids": [43, 52, 15],
    "libsvm_files": [
      "australian_scale.txt",
      "heart.txt",
      "sonar.txt",
      "german.txt",
      "splice.txt"
    ],
    "libsvm_dir": "data/libsvm",
    "expected_results_file": "data/expected_results.csv"
  },
  "svm": {
    "C": [13],
    "kernel_types": ["linear", "poly", "rbf", "custom_hermite", "custom_gegen"],
    "poly": {
      "degree": [3],
      "gamma": ["scale", "auto"],
      "coef0": [1.0]
    },
    "rbf": {
      "gamma": ["scale", "auto"]
    },
    "custom_hermite": {
      "degree": [3]
    },
    "custom_gegen": {
      "degree": [3],
      "alpha": [0.1]
    }
  },
  "cross_validation": {
    "n_splits": 10,
    "shuffle": true,
    "random_state": 42,
    "n_jobs": -1
  },
  "output": {
    "results_dir": "results",
    "plots_dir": "results/plots",
    "log_level": "INFO"
  }
}
